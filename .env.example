# 本地后端
PORT=3000
ACCESS_PASSWORD=replace-with-a-private-access-password

# 日常模式：DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-flash

# 亲密模式：OpenRouter 中转 Gemini
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=google/gemini-3.5-flash-lite

# 长期记忆：阿里云新加坡 Embedding
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_EMBEDDING_URL=https://ws-j209z8dke552zl.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/embeddings
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

# 当前主线数据库：Supabase PostgreSQL + pgvector
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-supabase-service-role-key
SUPABASE_VOICE_BUCKET=voice-audio

# 语音任务正文在 Supabase 中加密保存；Worker 使用独立令牌访问任务
VOICE_TASK_KEY=replace-with-32-byte-base64-key
VOICE_WORKER_TOKEN=replace-with-private-worker-token

# 本地跨端口开发；部署到 Vercel 同域运行时通常不需要 VITE_API_BASE_URL
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:3000
